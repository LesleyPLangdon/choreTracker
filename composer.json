{
    "name": "lesleyplangdon/chore-tracker",
    "description": "Family chore tracker (PHP JSON API + vanilla JS front end)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload-dev": {
        "psr-4": { "App\\": "api/src/", "Tests\\": "tests/" }
    },
    "config": { "sort-packages": true }
}
